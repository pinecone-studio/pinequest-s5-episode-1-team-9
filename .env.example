# ─── LinguaMatch environment ──────────────────────────────────────────────
# Local development: copy to .env (cp .env.example .env). One file serves both
# apps: the server reads ../.env, and next.config.ts loads it for the web app.
# Production: server variables go in Render, web variables in Vercel (see README).

# --- Server (Render) ------------------------------------------------------
NODE_ENV=development
# Render sets PORT itself; don't set it there.
PORT=4000
# Exact origin(s) of the web app allowed to call the API and open sockets,
# comma-separated, no trailing slash. http://localhost:3000 is always allowed
# outside production. Production: https://linguamatch.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# Neon Postgres. `neon env pull` fills both. Use a dev branch locally, never
# production. DATABASE_URL is the pooled (-pooler) host the app queries;
# DATABASE_URL_UNPOOLED is the direct host drizzle-kit migrates through
# (falls back to DATABASE_URL). Apply migrations with `npm run db:migrate -w server`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk handles sign-in. `clerk env pull --file .env` fills these from the
# Clerk dashboard (API keys). The server verifies Clerk session tokens on every
# REST call and in the Socket.IO handshake; it refuses to start without them.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- AI -------------------------------------------------------------------
# The AI layer is provider-agnostic (server/src/services/ai). Implemented:
# "anthropic" (paid) and "gemini" (Google, has a free tier — get a key at
# https://aistudio.google.com/apikey). Without a key, the app runs but topics,
# assessment and feedback clearly report that AI is unavailable — nothing is faked.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- WebRTC ---------------------------------------------------------------
# Public STUN servers work for most home networks. Users behind strict/corporate
# NATs need a TURN relay (e.g. coturn, Twilio, Cloudflare Calls).
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Matchmaking ----------------------------------------------------------
# Max CEFR distance ever allowed (1 = B1 can meet A2/B2). Exact level is always tried first.
MATCH_MAX_LEVEL_DISTANCE=1
# Seconds of waiting before the acceptable level range widens by one step.
MATCH_EXPAND_AFTER_SECONDS=10
# How many recent partners to avoid re-matching with.
MATCH_RECENT_PARTNER_WINDOW=3

# --- Moderation -----------------------------------------------------------
# Distinct reporters within 24h that trigger an automatic 24h suspension.
MODERATION_AUTO_SUSPEND_REPORTS=3
# Comma-separated emails promoted to admin on sign-in, so you can bootstrap the first admin.
ADMIN_EMAILS=

# --- Web (Vercel) ---------------------------------------------------------
# Same value as CLERK_PUBLISHABLE_KEY. The web app also needs CLERK_SECRET_KEY
# (for its Clerk proxy); locally it reads the one above.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Both point at the API. In production that's the Render URL, e.g.
# https://linguamatch-api.onrender.com, and a Vercel build fails if either is missing.
# Where the browser opens the Socket.IO connection (baked in at build time).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Where Next.js proxies /api/* so REST calls stay same-origin (no CORS preflights).
API_URL=http://localhost:4000
