generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  DRAFT
  UPLOADING
  EXTRACTING_AUDIO
  TRANSCRIBING
  ANALYZING
  FINDING_VISUALS
  BUILDING_TIMELINE
  RENDERING
  PROCESSING
  READY
  FAILED
}

enum VisualType {
  NONE
  IMAGE
  BROLL
  GRAPHIC
  TEXT
  CHART
  HIGHLIGHT
  ZOOM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  videos    Video[]
}

model Video {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  originalUrl   String?
  originalKey   String?
  audioKey      String?
  processedUrl  String?
  processedKey  String?
  filename      String
  title         String
  duration      Float       @default(0)
  status        VideoStatus @default(DRAFT)
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  transcript   Transcript?
  edits        VideoEdit[]

  @@index([userId])
  @@index([status])
}

model Transcript {
  id        String              @id @default(cuid())
  videoId   String              @unique
  video     Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  language  String              @default("mn")
  fullText  String
  createdAt DateTime            @default(now())
  segments  TranscriptSegment[]
}

model TranscriptSegment {
  id           String      @id @default(cuid())
  transcriptId String
  transcript   Transcript  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  startTime    Float
  endTime      Float
  text         String
  topic        String?
  importance   Float       @default(0)
  analysis     AIAnalysis?
  edits        VideoEdit[]

  @@index([transcriptId])
}

model AIAnalysis {
  id                String            @id @default(cuid())
  segmentId         String            @unique
  segment           TranscriptSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  topic             String
  keywords          String[]
  visualType        VisualType
  visualDescription String
  suggestedText     String
  confidence        Float
  reason            String          @default("")
}

model VisualAsset {
  id          String      @id @default(cuid())
  type        VisualType
  url         String
  thumbnail   String?
  title       String
  description String
  keywords    String[]
  source      String
  license     String?
  duration    Float?
  edits       VideoEdit[]

  @@index([type])
}

model VideoEdit {
  id            String             @id @default(cuid())
  videoId       String
  video         Video              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  segmentId     String?
  segment       TranscriptSegment? @relation(fields: [segmentId], references: [id])
  visualAssetId String?
  visualAsset   VisualAsset?       @relation(fields: [visualAssetId], references: [id])
  startTime     Float
  endTime       Float
  position      String
  scale         Float              @default(1)
  opacity       Float              @default(1)
  editType      String
  feedback      Feedback[]

  @@index([videoId])
  @@index([segmentId])
}

model Feedback {
  id          String    @id @default(cuid())
  videoEditId String
  videoEdit   VideoEdit @relation(fields: [videoEditId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())

  @@index([videoEditId])
}
